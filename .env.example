APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Compte admin créé par `php artisan db:seed` (protège /admin)
ADMIN_NAME="Dorice DJETON"
ADMIN_EMAIL=admin@dorice-djeton.com
ADMIN_PASSWORD=change-me-please

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local : mailpit (par défaut ci-dessous).
# En production : identifiants SMTP Brevo (https://app.brevo.com/settings/keys/smtp).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Config Brevo (à utiliser en production, remplace les 5 lignes MAIL_* ci-dessus) :
# Identifiants dans Brevo : Paramètres (engrenage) > SMTP & API > onglet SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=9xxxxx001@smtp-brevo.com  (le "Login SMTP" affiché dans Brevo, PAS l'email du compte)
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx           (la clé SMTP générée dans Brevo, pas ton mot de passe de compte)
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS doit être une adresse validée dans Brevo (Expéditeurs, domaines & délivrabilité)

# Adresse qui reçoit les messages du formulaire de contact
MAIL_TO_ADDRESS=djetondory@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
